      pos="0.9125 -5.05925 -1" size="0.1875 4.94075 1"
      rgba="0.75 0.25 0.45 0"/>

    <!--
      Passive deformable-support slots. All geoms initially top out at z=0.
      terrain.py enables either one mechanically coupled plate per side or four
      independent cells. Gravity compensation cancels tile self-weight only;
      robot contact load drives the unactuated vertical slide joints.
    -->
    <body name="deformable_balanced_left" gravcomp="1">
      <inertial pos="0.725 5 -0.05" mass="5" diaginertia="1 1 1"/>
      <joint name="deformable_balanced_left_slide" type="slide" axis="0 0 1"
        range="-0.04 0" stiffness="7000" damping="374"/>
      <geom name="terrain_deformable_balanced_left_entry_medial" type="box"
        pos="0.5375 0.05925 -0.05" size="0.1875 0.05925 0.05"
        density="0" contype="0" conaffinity="0" rgba="0.20 0.65 0.35 0"/>
