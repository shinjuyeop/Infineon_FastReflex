        pos="0.5375 5.05925 -0.05" size="0.1875 4.94075 0.05"
        density="0" contype="0" conaffinity="0" rgba="0.20 0.65 0.35 0"/>
      <geom name="terrain_deformable_balanced_left_exit_medial" type="box"
        pos="0.9125 0.05925 -0.05" size="0.1875 0.05925 0.05"
